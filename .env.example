# Repo-root secrets: build-time / CLI / CI use only, not app runtime config.
# Copy to .env and fill in real values. Never commit .env.
# For values that must exist at EAS build time rather than local runtime,
# use `eas secret:create` instead of a committed/local .env file.

# Supabase free tier caps at 2 active projects total (see docs/ISP_App_Full_Development_Process.md,
# Part 1). We only provision `dev` and `prod` for now — `staging` is deferred
# until Phase 10/11, and `dev` temporarily absorbs staging-like testing until
# then. Treat any "real-feeling" test data on `dev` with staging-level care.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DEV_PROJECT_REF=
SUPABASE_PROD_PROJECT_REF=

# Project API keys (dev) — secret key is server-side only (seed scripts,
# Edge Functions), never shipped to the Expo app. Publishable key mirrors
# into apps/mobile/.env as EXPO_PUBLIC_SUPABASE_ANON_KEY.
SUPABASE_DEV_URL=
SUPABASE_DEV_PUBLISHABLE_KEY=
SUPABASE_DEV_SECRET_KEY=

# Sentry (source map upload on release builds)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Supabase Edge Functions (server-side, set via `supabase secrets set`, not this file)
# SENTRY_DSN_EDGE=
