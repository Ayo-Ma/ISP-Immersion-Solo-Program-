# Copy to .env and fill in real values. Never commit .env.
# Expo only exposes vars prefixed EXPO_PUBLIC_ to client code — anything
# without that prefix is silently unavailable at runtime, not a build error.

# Supabase (dev project — see /docs SETUP.md)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Sentry (client-side error tracking)
EXPO_PUBLIC_SENTRY_DSN=

# OneSignal (push notifications)
EXPO_PUBLIC_ONESIGNAL_APP_ID=
